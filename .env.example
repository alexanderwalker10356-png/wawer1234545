# ============================================================
# Environment Configuration — Multi-tenant White-Label Platform
# Copy to .env and fill in your values: cp .env.example .env
# ============================================================

# ── Telegram Bot ──────────────────────────────────────────────
# Get from @BotFather
BOT_TOKEN=123456789:ABCDefGhIjKlMnOpQrStUvWxYz

# Your personal Telegram user ID (get from @userinfobot)
ADMIN_TELEGRAM_ID=123456789

# ── Payment Gateway ───────────────────────────────────────────
# API endpoint of your payment provider (CMI, Stripe, etc.)
PAYMENT_GATEWAY_URL=https://payment.example.com/api

# API key and secret from your payment provider dashboard
PAYMENT_API_KEY=pk_live_xxxxxxxxxxxx
PAYMENT_SECRET=sk_live_xxxxxxxxxxxx

# ── White-label Config ────────────────────────────────────────
# Path to brands.json (default works for Docker)
BRANDS_JSON_PATH=/app/white-label/brands.json

# ── Server Monitoring ─────────────────────────────────────────
# Comma-separated list of servers to monitor
SERVER_HOSTS=localhost

# ── Deployment (deploy.sh) ────────────────────────────────────
# Email for Let's Encrypt SSL certificates
CERTBOT_EMAIL=admin@ticket.ma

# MySQL root password (auto-generated if not set)
# MYSQL_ROOT_PASSWORD=your-secure-password
