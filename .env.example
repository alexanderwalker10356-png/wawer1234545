# ============================================================
# Environment Configuration
# Copy to .env and fill in real values: cp .env.example .env
# ============================================================

# ── SSH Access ────────────────────────────────────────────────
# Path to your SSH private key (used for all servers)
SSH_KEY_PATH=~/.ssh/id_rsa

# ── Server IPs (fill these into servers.conf) ────────────────
# SERVER_1_IP=203.0.113.10   # ticket.ma
# SERVER_2_IP=203.0.113.20   # majourneys.com
# SERVER_3_IP=203.0.113.30   # marrakech-desert-trips.com
# SERVER_4_IP=203.0.113.40   # oncf-voyages.ma
# SERVER_5_IP=203.0.113.50   # ctm.ma
# SERVER_6_IP=203.0.113.60   # supratours.ma

# ── SSL / Certbot ─────────────────────────────────────────────
CERTBOT_EMAIL=admin@ticket.ma

# ── Telegram Bot ──────────────────────────────────────────────
BOT_TOKEN=123456789:ABCDefGhIjKlMnOpQrStUvWxYz
ADMIN_TELEGRAM_ID=123456789

# ── Payment Gateway ───────────────────────────────────────────
PAYMENT_GATEWAY_URL=https://payment.example.com/api
PAYMENT_API_KEY=pk_live_xxxxxxxxxxxx
PAYMENT_SECRET=sk_live_xxxxxxxxxxxx

# ── White-label Config ────────────────────────────────────────
BRANDS_JSON_PATH=/app/white-label/brands.json

# ── Server Monitoring (comma-separated) ───────────────────────
SERVER_HOSTS=203.0.113.10,203.0.113.20,203.0.113.30,203.0.113.40,203.0.113.50,203.0.113.60
